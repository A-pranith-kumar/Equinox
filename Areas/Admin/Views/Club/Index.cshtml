@model IEnumerable<Equinox.Models.DomainModels.Club>

<h2>Club List</h2>

@* server messages *@
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["Message"] != null || TempData["Success"] != null)
{
    <div class="alert alert-success">@((TempData["Message"] ?? TempData["Success"])!)</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Club</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
    <tr>
        <td>@item.Name</td>
        <td>@item.PhoneNumber</td>
        <td>
            <a asp-action="Edit" asp-route-id="@item.ClubId">Edit</a> |
            <a asp-action="Details" asp-route-id="@item.ClubId">Details</a> |
            <a asp-action="Delete" asp-route-id="@item.ClubId">Delete</a>
        </td>
    </tr>
}
    </tbody>
</table>

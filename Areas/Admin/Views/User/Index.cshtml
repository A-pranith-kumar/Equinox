@model Equinox.Models.ViewModels.PagedResult<Equinox.Models.DomainModels.User>

@{
    ViewData["Title"] = "Coach List";
}

<h2 class="text-center mb-4">Coach List</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Message"] != null || TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @((TempData["Message"] ?? TempData["Success"])!)
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="text-muted">
        Showing @Model.FirstItemNumber–@Model.LastItemNumber of @Model.TotalCount
    </div>
    <div>
        <a class="btn btn-primary"
           asp-area="Admin"
           asp-controller="User"
           asp-action="Create">
           Create New Coach
        </a>
    </div>
</div>

@if (Model.TotalCount == 0)
{
    <div class="alert alert-info">No coaches yet. Click “Create New Coach”.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>DOB</th>
                <th style="width: 220px;">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var coach in Model.Items)
        {
            <tr>
                <td>@coach.Name</td>
                <td>@coach.PhoneNumber</td>
                <td>@coach.Email</td>
                <td>@(coach.DOB?.ToString("dd-MM-yyyy") ?? "")</td>
                <td>
                    <a asp-area="Admin" asp-controller="User" asp-action="Edit"    asp-route-id="@coach.UserId">Edit</a> |
                    <a asp-area="Admin" asp-controller="User" asp-action="Details" asp-route-id="@coach.UserId">Details</a> |
                    <a asp-area="Admin" asp-controller="User" asp-action="Delete"  asp-route-id="@coach.UserId">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <!-- Pager -->
    <nav aria-label="Users pagination">
        <ul class="pagination">
            <li class="page-item @(Model.HasPrev ? "" : "disabled")">
                <a class="page-link"
                   asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index"
                   asp-route-page="@(Model.Page - 1)">Prev</a>
            </li>

            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link"
                       asp-area="Admin"
                       asp-controller="User"
                       asp-action="Index"
                       asp-route-page="@p">@p</a>
                </li>
            }

            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link"
                   asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index"
                   asp-route-page="@(Model.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}

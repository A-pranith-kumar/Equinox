@model IEnumerable<Equinox.Models.User>

@{
    ViewData["Title"] = "Coach List";
}

<h2 class="text-center mb-4">Coach List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Coach</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>DOB</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var coach in Model)
{
    <tr>
        <td>@coach.Name</td>
        <td>@coach.PhoneNumber</td>
        <td>@coach.Email</td>
        <td>@coach.DOB.ToShortDateString()</td>
        <td>
            <a asp-action="Edit" asp-route-id="@coach.UserId">Edit</a> |
            <a asp-action="Details" asp-route-id="@coach.UserId">Details</a> |
            <a asp-action="Delete" asp-route-id="@coach.UserId">Delete</a>
        </td>
    </tr>
}
    </tbody>
</table>
